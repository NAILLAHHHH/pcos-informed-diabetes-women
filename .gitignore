# Raw / large data — never commit datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
*.zip
*.parquet
*.xlsx

# Model artifacts — store on Google Drive for the assignment
models/*
!models/.gitkeep
*.pkl
*.joblib
*.h5
*.keras
saved_model/
*.pb

# Notebook / Python
.ipynb_checkpoints/
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.env
.DS_Store

# Figures regenerated by notebooks (optional local cache)
# Keep committed figures/ if used in the report; ignore huge dumps
*.pt
*.onnx

# IDE
.idea/
.vscode/
*.swp

# Local Drive packages (contain dataset/models)
deliverables/

