# Raw / large data — never commit datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
!report/experiment_results/*.csv
*.zip
*.parquet
*.xlsx

# Model artifacts — store on Google Drive for the assignment
models/*
!models/.gitkeep
*.pkl
*.joblib
*.h5
*.keras
*_local_only.joblib
best_traditional_ml_full_local_only.joblib
saved_model/
*.pb

# Notebook / Python
.ipynb_checkpoints/
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.env
.DS_Store

# Figures regenerated by notebooks (optional local cache)
# Keep committed figures/ if used in the report; ignore huge dumps
*.pt
*.onnx

# IDE
.idea/
.vscode/
*.swp

# W&B local offline runs (large; keep experiment_table.csv in git)
wandb/
*/wandb/

# Local Drive packages (contain dataset/models)
deliverables/

# Student-only helpers (not needed for grading; keep FULL_REPORT + experiment_results)
report/VIDEO_SCRIPT.md
report/DRIVE_AND_VIDEO_CHECKLIST.md
report/REPORT_OUTLINE.md
report/01_introduction_draft.md
report/02_literature_review_draft.md
report/03_methodology_draft.md
report/04_results_draft.md
report/05_discussion_draft.md
report/06_conclusion_draft.md
report/experiment_results/compact_rf_metrics.txt
report/experiment_results/run_meta.json

